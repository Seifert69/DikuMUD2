# MS: CHANGED SYSPORT		=	-DLINUX -DGENERIC_SYSV
# This is how my Linux works.

SYSPORT		=	-DLINUX -DPOSIX

# The sources are pre-standard C++ (e.g. `register`, removed in C++17).
EXTRA_CFLAGS	=	-std=gnu++98

CPP             =       g++
CC		=	g++
LD		=	g++
MKDPND		=	g++ -MM $(CFL)
LEX		=	flex
YACC		=	bison -y
DIFF		=	diff

ZONEDIR		=	zon/
